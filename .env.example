# Copy to .env and fill in. Never commit .env.

# App
APP_URL=http://localhost:3032
# Used by iron-session to encrypt cookies. At least 32 characters: openssl rand -base64 32
SESSION_SECRET=

# Money. ISO 4217 code. All amounts are stored as integer minor units of this currency.
CURRENCY=PHP

# Database (Neon connection string). Prisma migrations need the direct, non-pooled one.
DATABASE_URL=
# Optional. npm test truncates tables, so it needs a database whose name ends in _test.
# Defaults to a local leslie_test: createdb leslie_test
TEST_DATABASE_URL=

# Seeded logins (hashed at seed time)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_TREASURER_EMAIL=
SEED_TREASURER_PASSWORD=

# AI. The AI SDK Google provider reads this exact variable name.
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_MODEL=

# PayPal (sandbox only). From developer.paypal.com > Apps & Credentials.
# The app needs the Payouts feature, and Transaction Search for list_transactions.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same value as PAYPAL_CLIENT_ID. Exposed to the browser for the JS SDK donate buttons.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Sandbox Personal or Business account email that receives reimbursements.
PAYPAL_CHARITY_RECEIVER_EMAIL=
